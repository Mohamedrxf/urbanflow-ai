# UrbanFlow AI Backend Configuration

# Application
APP_NAME=UrbanFlow AI API
APP_VERSION=1.0.0
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma separated list of allowed origins; never use "*" with credentials)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/urbanflow_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters; the app refuses to start without it when DEBUG=False
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/ML Models
MODEL_PATH=./ai-engine/models
MODEL_VERSION=v1.0.0

# External APIs
TRAFFIC_API_KEY=your-traffic-api-key
WEATHER_API_KEY=your-weather-api-key
MAPS_API_KEY=your-maps-api-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0